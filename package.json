{
  "name": "cage-boss",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "description": "CAGE BOSS - a satirical MMA-promoter management sim",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "tsx tools/sim.ts",
    "validate": "tsx tools/validate.ts",
    "namegen": "tsx tools/namegen.ts",
    "desktop": "vite build && electron .",
    "desktop:windowed": "vite build && electron . --windowed",
    "dist:win": "tsc --noEmit && vite build && electron-builder --win portable nsis --x64 --publish never",
    "dist:linux": "tsc --noEmit && vite build && electron-builder --linux AppImage tar.gz --x64 --publish never",
    "dist:win:nowine": "tsc --noEmit && vite build && electron-builder --win dir --x64 -c.win.signAndEditExecutable=false && node tools/stamp-exe.mjs \"release/win-unpacked/CAGE BOSS.exe\" build/icon.ico && electron-builder --win portable --x64 --prepackaged release/win-unpacked -c.win.signAndEditExecutable=false --publish never",
    "dist:mac": "tsc --noEmit && vite build && electron-builder --mac dmg zip --x64 --arm64 --publish never"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@types/node": "^26.6.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "lz-string": "^1.5.0",
    "pixi.js": "^8.22.0",
    "resedit": "^2.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "main": "electron/main.cjs",
  "author": "Riley \"Monkey Man\" Poirier",
  "build": {
    "appId": "com.rpoirier.cageboss",
    "productName": "CAGE BOSS",
    "copyright": "Riley \"Monkey Man\" Poirier",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json",
      "node_modules/**/*",
      "build/icon-1024.png"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "CAGE-BOSS-${version}-${arch}-${target}.${ext}"
    },
    "portable": {
      "artifactName": "CAGE-BOSS-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "CAGE BOSS",
      "artifactName": "CAGE-BOSS-${version}-setup.exe"
    },
    "linux": {
      "icon": "build/icon-1024.png",
      "category": "Game",
      "synopsis": "A satirical pixel MMA game: run the promotion, or fight your way to the belt.",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CAGE-BOSS-${version}-linux-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "RileyPoirier23",
        "repo": "CAGEBOSS",
        "releaseType": "release"
      }
    ],
    "afterPack": "build/afterPack.cjs",
    "mac": {
      "icon": "build/icon-1024.png",
      "category": "public.app-category.games",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "CAGE-BOSS-${version}-mac-${arch}.${ext}",
      "darkModeSupport": true
    },
    "dmg": {
      "title": "CAGE BOSS ${version}",
      "artifactName": "CAGE-BOSS-${version}-mac-${arch}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
