; CAGE BOSS: the Godot port (consoles and phones). See docs/console/ENGINE.md.
config_version=5

[application]
config/name="CAGE BOSS"
config/description="Run an MMA promotion, or fight your way to the title."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5")
boot_splash/bg_color=Color(0.07, 0.06, 0.08, 1)
boot_splash/show_image=false

[display]
window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"
window/handheld/orientation=4

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[rendering]
textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.07, 0.06, 0.08, 1)
2d/snap/snap_2d_transforms_to_pixel=false
